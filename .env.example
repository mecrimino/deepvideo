# Deep Video — local-only configuration. Copy to .env (no cloud keys needed for v1).

# Fastify server
PORT=8787

# Ollama (OpenAI-compatible endpoint) — the agent LLM
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# whisper.cpp model used by nodejs-whisper (tiny.en | base.en | small.en | ...)
WHISPER_MODEL=base.en

# Where the clip index, exports, and cached models live
DATA_DIR=./server/data
