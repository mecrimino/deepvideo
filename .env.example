# Deep Video — local-only configuration. Copy to .env (no cloud keys needed for v1).

# Fastify server
PORT=8787

# Ollama (OpenAI-compatible endpoint) — the agent LLM
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# whisper.cpp model used by nodejs-whisper (tiny.en | base.en | small.en | ...)
WHISPER_MODEL=base.en

# Where the clip index, exports, and cached models live
DATA_DIR=./server/data

# External free-tier APIs — see api.md for models, limits, and usage.
# Comma-separate multiple keys for rotation. Real values go in .env only.
OPENROUTER_MODEL=tencent/hy3:free
OPENROUTER_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEYS=
PEXELS_API_KEYS=
PIXABAY_API_KEYS=
CF_IMAGE_WORKER_URL=
CF_IMAGE_WORKER_SECRET=
POLLINATIONS_IMAGE_URL=https://image.pollinations.ai/prompt/{prompt}

