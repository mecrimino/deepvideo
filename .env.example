# Deep Vision — environment (copy to .env; never commit .env).
# Every key is OPTIONAL. With none set, the core still runs end-to-end using
# deterministic fallbacks (no LLM polish, no stock footage) — heavy AI simply
# degrades to local logic (Ch20: low-end PC + cloud APIs, cache aggressively).

# --- LLM (agent brains). Comma/space separated for key rotation. -----------
OPENROUTER_API_KEYS=
GROQ_API_KEYS=
OPENAI_API_KEYS=

# --- Stock media (Ch12/Ch13 retrieval) -------------------------------------
PEXELS_API_KEYS=
PIXABAY_API_KEYS=

# --- Web research (Ch9, optional) ------------------------------------------
TAVILY_API_KEYS=

# --- Model routing (Ch1.7). Override the defaults if you like. --------------
# LLM_MODEL_FAST=tencent/hunyuan-a13b-instruct:free
# LLM_MODEL_SMART=deepseek/deepseek-chat-v3-0324:free

# --- Networking ------------------------------------------------------------
# CORE_HOST=127.0.0.1
# CORE_PORT=8000
# BACKEND_PORT=8787
# CORE_URL=http://127.0.0.1:8000     # used by the Node gateway to reach the core
